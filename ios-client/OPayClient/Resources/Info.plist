<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>OPay</string>
    <key>CFBundleIdentifier</key>
    <string>com.opay.client</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Permissions -->
    <key>NSFaceIDUsageDescription</key>
    <string>OPay uses Face ID to authorize payments via the Secure Enclave.</string>

    <!-- Configure gateway phone and server URL here or in Xcode build settings -->
    <key>OPAY_GATEWAY_PHONE</key>
    <string>+919380865986</string>
    <key>OPAY_SERVER_URL</key>
    <string>http://192.168.29.106:8080</string>

    <!-- Allow local network HTTP (remove in production / use HTTPS) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>192.168.29.106</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
            <key>192.168.29.7</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <!-- Deep Link URL Scheme Configuration -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.opay.client</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>opay</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
